# ---------------------------------------------------------------------------
# TrustVault Environment Configuration (.env)
# ---------------------------------------------------------------------------

# Environment Mode: development | test | production
ENV=development

# PostgreSQL Database Configuration
POSTGRES_DB=trustvault
POSTGRES_USER=vault
POSTGRES_PASSWORD=vaultpass
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://vault:vaultpass@db:5432/trustvault

# Security & Cryptography Keys
# MUST be replaced with cryptographically strong secrets in production!
SECRET_KEY=change-this-super-secret-jwt-key-in-production-min32bytes
ENCRYPTION_KEY=trustvault-master-aes-gcm-key-32bytes-must-be-rotated
AUDIT_HMAC_KEY=trustvault-audit-hmac-key-changeme-min-32bytes

# Storage Configuration
STORAGE_DIR=/var/vault/storage

# Networking & Ports
API_PORT=8000
WEB_PORT=80

# Optional AI Sharing Assistant
# If set, enables LLM fallback for access suggestions (sees only doc metadata, NEVER file contents)
# ANTHROPIC_API_KEY=sk-ant-api03-...
